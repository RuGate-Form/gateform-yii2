{
    "name": "gateform/yii2",
    "description": "Интеграция GateForm с Yii2: компонент, валидатор, фильтр действий и виджеты формы, отзывов и связи.",
    "type": "yii2-extension",
    "license": "MIT",
    "keywords": [
        "yii2",
        "gateform",
        "captcha",
        "spam",
        "form-protection",
        "reviews",
        "widget"
    ],
    "homepage": "https://gateform.ru",
    "authors": [
        {
            "name": "GateForm",
            "homepage": "https://gateform.ru"
        }
    ],
    "support": {
        "issues": "https://github.com/RuGate-Form/gateform-yii2/issues",
        "source": "https://github.com/RuGate-Form/gateform-yii2"
    },
    "require": {
        "php": ">=8.1",
        "gateform/sdk": "^1.0",
        "yiisoft/yii2": "^2.0.49"
    },
    "autoload": {
        "psr-4": {
            "GateForm\\Yii2\\": "src/"
        }
    },
    "scripts": {
        "lint": "php tests/lint.php"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
